{
  "manifest_version": 3,
  "name": "SGC ↔ GDoc · Emissão e acompanhamento de processos",
  "version": "3.3.0",
  "description": "Acompanha no GDoc os processos das parcelas (tramitação, NF e NL) e a caixa do setor para a Gestão do GDoc do SGC.",
  "permissions": ["storage", "scripting", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://gdoc.belem.pa.gov.br/*",
    "https://belem-contratos.vercel.app/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SGC ↔ GDoc", "default_icon": "icone.png" },
  "options_page": "opcoes.html",
  "content_scripts": [
    {
      "matches": ["https://belem-contratos.vercel.app/*"],
      "js": ["content-sgc.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gdoc.belem.pa.gov.br/gdocprocessos/*"],
      "js": ["content-gdoc.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "128": "icone.png" }
}
