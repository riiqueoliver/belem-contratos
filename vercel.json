{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/moduloarcanjo",
      "destination": "/moduloarcanjo/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/relatorios.js": {
      "maxDuration": 60
    },
    "api/ia.js": {
      "maxDuration": 300
    }
  }
}
